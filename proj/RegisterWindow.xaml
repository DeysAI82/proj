<Window x:Class="proj.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="450" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="First Name:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Margin="120,0,0,0" Width="200" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Last Name:" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Margin="120,0,0,0" Width="200" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Email:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Margin="120,0,0,0" Width="200" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Password:" Grid.Row="3" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="3" Margin="120,0,0,0" Width="200" PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Text="Phone:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Margin="120,0,0,0" Width="200" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Content="Register" Grid.Row="5" Width="100" Height="30"  HorizontalAlignment="Center" Margin="0,10,0,153"
                Command="{Binding RegisterCommand}"/>
    </Grid>
</Window>
