<Window x:Class="proj.EditUserWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:proj"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="850"
      Title="Редактирование пользователя" Width="300" Height="350">

    <StackPanel Margin="10">

        <TextBlock Text="Имя:"/>
        <TextBox Text="{Binding FirstName}" Margin="0 5"/>

        <TextBlock Text="Фамилия:"/>
        <TextBox Text="{Binding LastName}" Margin="0 5"/>

        <TextBlock Text="Password:"/>
        <TextBox Text="{Binding PasswordHash}" Margin="0 5"/>

        <TextBlock Text="Email:"/>
        <TextBox Text="{Binding Email}" Margin="0 5"/>

        <TextBlock Text="Телефон:"/>
        <TextBox Text="{Binding Phone}" Margin="0 5"/>

        <CheckBox Content="Активен" IsChecked="{Binding IsActive}" Margin="5"/>

        <Button Content="OK" Width="80"
                HorizontalAlignment="Center"
                Margin="10"
                Click="Ok_Click"/>

    </StackPanel>
</Window>

