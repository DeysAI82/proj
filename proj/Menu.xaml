<Window x:Class="proj.Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:proj"
      xmlns:conv="clr-namespace:proj.Conventers"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="500"
      Title="Menu" Height="500" Width="600">
    <Window.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
            <TextBlock Text="Главное меню" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      HorizontalAlignment="Center" 
                      Margin="0,0,0,30"/>

            <Button x:Name="btnMainWindow" 
                    Content="Перейти к базе данных" 
                    Width="200" 
                    Height="40" 
                    Margin="0,10" 
                    Click="btnMainWindow_Click"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>

            <Button x:Name="btnRedact" 
                    Content="Перейти в Каталог" 
                    Width="200" 
                    Height="40" 
                    Margin="0,10" 
                    Click="btnRedact_Click"/>

            <Button x:Name="btnRent" 
                    Content="Перейти к Аренде" 
                    Width="200" 
                    Height="40" 
                    Margin="0,10" 
                    Click="btnRent_Click"/>
        </StackPanel>
    </Grid>
</Window>
