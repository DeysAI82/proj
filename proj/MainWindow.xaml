<Window x:Class="proj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proj"
        xmlns:vm="clr-namespace:proj.ViewModels"
        xmlns:conv="clr-namespace:proj.Conventers"
        mc:Ignorable="d"
        x:Name="win"
        Title="MainWindow" Height="450" Width="600">
    <Window.Resources>
        <conv:CutOffUserConventer x:Key="CutOffUserConventer" />
    </Window.Resources>
    <d:Window.DataContext>
        <vm:MainWindowViewModel/>
    </d:Window.DataContext>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Background="#E5E7EB" Height="50" LastChildFill="False" VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal" Margin="10,5" DockPanel.Dock="Left">
                <Button Content="Вернуться в меню" Width="150" Margin="0,0,10,0" Click="BackToMenu_Click"/>
                <Button Content="ADD" Command="{Binding AddCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="UPDATE" Command="{Binding UpdateCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="DELETE" Command="{Binding DeleteCommand}" Width="100"/>
            </StackPanel>
            
        </DockPanel>

        <ListView Grid.Row="1"
             ItemsSource="{Binding Users}"
             SelectedItem="{Binding SelectedUser}"
             BorderThickness="0"
             Background="White"
             Margin="2">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" Margin="1" Width="500" BorderThickness="2" BorderBrush="Black">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                    Value="{Binding ElementName=win, Path=Background}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, Converter={StaticResource CutOffUserConventer}}"
                                             Value="True">
                                        <Setter Property="Background" Value="LightCoral"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <DockPanel>
                            <TextBlock TextAlignment="Center" 
                                   DockPanel.Dock="Right" 
                                   Text="{Binding IsActive, StringFormat='IsActive:{0}'}"/>

                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold">
                                <Run Text="{Binding UserId}"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding FirstName}"/>
                                <Run Text="{Binding LastName}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Phone, StringFormat='номер тел: {0}'}"/>

                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Email}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Email}" Value="">
                                                    <Setter Property="Text" Value="Информация не найдена"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
